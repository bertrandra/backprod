      "$comment": "The screen U11 found missing and U12 made this platform's own. It has a route so it is addressable and so this area can declare one, but nothing links to it: SignInGate renders it *instead of* the shell for whatever URL was asked for, which is how a deep link survives signing in.",
      "routes": [
        "/sign-in"
      ],
      "operations": [
        "refreshSession",
        "signIn",
        "signOut"
      ]
    },
