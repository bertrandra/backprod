{
    "name": "bertrandra/backprod",
    "description": "Shared multi-product SaaS backend platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.8",
        "firebase/php-jwt": "^7.0",
        "nikic/fast-route": "^1.3",
        "php-di/php-di": "^7.0",
        "laminas/laminas-diactoros": "^3.3",
        "laminas/laminas-httphandlerrunner": "^2.10",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.68",
        "deptrac/deptrac": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml",
        "gate:proof": "@php tools/prove-architecture-gate.php",
        "test": "phpunit",
        "gates": [
            "@cs",
            "@stan",
            "@deptrac",
            "@gate:proof",
            "@gate:products",
            "@gate:plans",
            "@test"
        ],
        "migrate": "doctrine-migrations migrate --no-interaction --allow-no-migration",
        "gate:products": "@php tools/prove-no-product-branching.php",
        "gate:plans": "@php tools/prove-no-plan-branching.php"
    },
    "scripts-descriptions": {
        "gates": "Run the full quality gate chain exactly as CI does",
        "gate:proof": "Prove the Deptrac gate actually rejects an illegal dependency",
        "migrate": "Apply pending database migrations",
        "gate:products": "Prove no code branches on product identity (\u00a712.1)",
        "gate:plans": "Prove no code branches on a plan or tier name (\u00a713)"
    }
}
