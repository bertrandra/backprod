# Backprod — the server's configuration. Copy to `.env` beside this file.
#
# This file lives in the application directory, which is *outside* the document
# root, so no request can read it. Keep it that way: §31 says secrets stay out of
# Git and out of anywhere a browser can reach.
#
# Every value below defaults to "off", and each default is safe on its own. What
# is not safe is the combination: a deployment with none of them set starts
# cleanly, answers /api/v1/health with `ok`, and does almost nothing. Run
# `php bin/preflight.php --strict` after filling this in — that is the check for
# exactly this failure.

# --- Database (required) -----------------------------------------------------
# PostgreSQL, and the only external service this deployment needs at all.
# SiteGround does not host PostgreSQL, so this points somewhere else: Supabase,
# Neon, Railway, or your own server. Nothing else about the platform reaches
# outside the host.
#
# `sslmode=require` is not optional over the public internet, and Supabase
# refuses a plaintext connection anyway. Use the *session* pooler port (5432) or
# the direct connection — the transaction pooler (6543) does not support the
# prepared statements DBAL issues.
DATABASE_DSN=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# --- Identity (required) -----------------------------------------------------
# This platform issues its own tokens (U12), so there is no identity provider to
# configure and no key in the browser. One secret does it.
#
# **At least 32 characters.** HS256 refuses a shorter key and sign-in then answers
# 503 saying exactly that. Generate one on the host:
#
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
#
# Empty, nobody can sign in. Change it and everybody is signed out at once, which
# is also how you revoke every session in an emergency.
AUTH_SIGNING_SECRET=

# The rest have working defaults. Uncomment only if you run two deployments that
# must not accept each other's tokens.
# AUTH_ISSUER=backprod
# AUTH_AUDIENCE=backprod-api
# AUTH_TOKEN_LIFETIME=3600

# --- Signed download links (required) ----------------------------------------
# Any long random string, private to this deployment. Exports and uploaded files
# are handed out as signed links; without a secret none can be produced, so the
# feature is not degraded — it is off.
#
# Generate one with:  php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
ASSET_LINK_SIGNING_SECRET=

# --- Where uploaded bytes live (required on shared hosting) ------------------
# Outside the document root, always. Unset, the platform falls back to the system
# temporary directory — which on shared hosting is swept, so uploads would vanish
# at a time unrelated to anything anybody did.
ASSET_STORAGE_ROOT=/home/USER/www/DOMAIN/backprod-app/var/assets

# Where mPDF assembles an invoice before it is sent. Same reasoning; it needs a
# few megabytes and must be writable by the web server user.
PDF_TEMPORARY_ROOT=/home/USER/www/DOMAIN/backprod-app/var/pdf

# --- Cross-origin requests ---------------------------------------------------
# Leave empty. The UI and the API are served from one origin in this deployment,
# so the browser makes no cross-origin request and there is nothing to allow.
# Adding an origin here widens the platform's attack surface for no gain unless
# another site genuinely calls this API.
CORS_ALLOWED_ORIGINS=

# --- Proxies -----------------------------------------------------------------
# Addresses whose X-Forwarded-For may be believed. SiteGround serves through its
# own reverse proxy, so without this the rate limiter sees one client address for
# every visitor and throttles them collectively.
#
# Ask support for the internal proxy address rather than guessing: a wrong value
# here means a caller can spoof their own address and buy themselves an unlimited
# allowance, which is worse than the collective bucket.
TRUSTED_PROXIES=

# --- Rate limiting -----------------------------------------------------------
# The defaults are §31's. Raise them only with a reason.
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_PER_WINDOW=120
# RATE_LIMIT_PUBLIC_PER_WINDOW=30

# --- Taking money (optional) -------------------------------------------------
# Empty means no payment provider is configured: checkout cannot complete, so no
# subscription is ever activated. Nothing is provisioned before the money arrives
# (ADR-024) and the money cannot arrive — which is the correct behaviour for a
# deployment that has not connected a PSP, not a bug to work around.
STUB_PAYMENT_SIGNING_SECRET=

# --- Transmitting e-invoices (optional) --------------------------------------
# The adapter is a stub in any case (R3): the four transmission states are real
# and no certified Plateforme Agréée is connected. Setting this does not make the
# deployment compliant with the French obligation.
STUB_EINVOICE_SIGNING_SECRET=
