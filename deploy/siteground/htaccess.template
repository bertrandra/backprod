# Backprod — Apache configuration for the document root.
#
# Generated by bin/build-dist.sh. `@@CONNECT_SRC@@` becomes the whole `connect-src`
# source list at build time. Since U12 that is always `'self'`: this platform issues
# its own sessions, so the page never talks to a third party.
#
# The *list* is substituted rather than one source appended to `'self'`. Appending
# produced `connect-src 'self' 'none'` for a bundle with no provider, and `'none'`
# beside another source is invalid — the kind of thing that behaves differently in
# each browser and identically in no test. Since U12 there is no provider at all:
# every request the page makes is same-origin.
#
# Everything this platform serves over HTTP is under /api (config/routes.php),
# which is what makes the routing here two rules instead of a list that drifts.

Options -Indexes
DirectoryIndex index.html

# The application's own 404 is a screen inside the shell, not this file's job:
# any unknown path is a client-side route until the router says otherwise.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. The API. First, so nothing below can shadow it.
  RewriteRule ^api/ index.php [L]

  # 2. Anything that exists on disk — the fingerprinted assets, index.html, a
  #    favicon — is served as itself.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Everything else is a route the browser owns. Serving index.html rather
  #    than redirecting keeps the URL the person followed, which is the whole
  #    point of deep links.
  RewriteRule ^ index.html [L]
</IfModule>

# Nothing beginning with a dot is ever served. There should be no such file in
# here — the application and its .env live outside the document root — and that
# is exactly why this is cheap insurance rather than the actual defence.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Neither is anything that would only be here by mistake.
<FilesMatch "\.(env|ini|log|sql|sh|bak|swp|dist|lock|json\.gz)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Vite fingerprints every asset it emits, so the name changes when the bytes
  # do and these can be kept forever.
  <FilesMatch "\.(js|mjs|css|woff2?|svg|png|jpg|jpeg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The entry document is the one file whose name never changes, which makes it
  # the one that must not be cached: a deploy nobody's browser fetches is not a
  # deploy. Nothing is set for /api — PHP's own headers stand.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Nothing in this application is meant to be embedded, and an admin console
  # inside somebody else's iframe is how clickjacking gets its clicks.
  Header always set X-Frame-Options "DENY"

  # The policy, and the one concession in it.
  #
  # `style-src 'unsafe-inline'` is there because the application sets style
  # *attributes* — a colour swatch in the branding screen renders the tenant's
  # own hex value — and the alternative is a per-request nonce, which a document
  # root of static files cannot produce. It is inline styles only: scripts get no
  # such allowance, so the injection that actually matters is still refused.
  #
  # `connect-src 'self'` and nothing else. The browser talks to this origin only —
  # the API for data, and the same API for its session (ADR-038).
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src @@CONNECT_SRC@@"
</IfModule>

# Compression, if the host offers it. SiteGround does; this is written so that a
# host that does not simply serves the bytes uncompressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
