# Copy to .env and fill in. Never commit .env (Architecture V2 §31: secrets hors Git).

APP_ENV=dev
APP_DEBUG=true

# --- Identity (U12; supersedes ADR-014 for issuance) --------------------------
# This platform issues its own tokens now, so it needs no identity provider and
# the browser holds no key. One secret, and everything else has a default.
#
# At least 32 characters; shorter, the sign-in endpoint answers 503 saying so.
# Generate one with:
#
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
#
# Empty, nobody can sign in and nothing can be authenticated: the safe default for
# an unconfigured deployment, and `preflight` says so out loud.
#
# Sessions are signed EdDSA with a key pair derived from this secret (ADR-051
# milestone E); the public half is served at GET /api/v1/auth/jwks, so a product
# beside the platform verifies bearers without ever holding this value.
AUTH_SIGNING_SECRET=
# To rotate: move the current value here, put a new one above, and remove this
# line after one access-token lifetime (an hour by default). Tokens signed under
# the old secret verify until then; nothing is signed with it.
# AUTH_SIGNING_SECRET_PREVIOUS=
# Stamped into every token and checked on every request. The defaults are fine;
# they exist so a token minted for one deployment is refused by another that
# happens to share a secret, which is what a copied .env creates.
# AUTH_ISSUER=backprod
# AUTH_AUDIENCE=backprod-api
# How long an access token lives, in seconds. The refresh cookie lasts 30 days.
# AUTH_TOKEN_LIFETIME=3600

# --- Identity, the other way (ADR-014) ---------------------------------------
# Only if you want an external provider to issue tokens instead. Setting
# AUTH_SIGNING_SECRET wins over these, deliberately: a deployment given its own
# signing secret has been configured to be self-contained.
SUPABASE_JWKS=
SUPABASE_ISSUER=
SUPABASE_AUDIENCE=authenticated

# --- Where this deployment answers -------------------------------------------
# Used to build the links this platform puts in emails — today, the address
# confirmation a storefront sign-up sends. There is no default on purpose:
# deriving it from a request's Host header would let anybody who can reach the
# API decide where a confirmation link points. Left empty, the link is relative
# and therefore useless in a mail client, which is the honest failure.
APP_URL=https://your-domain.example

# --- Sending mail ------------------------------------------------------------
# Where the emails go out — a reset link, an invitation, an address
# confirmation, a failed payment. A Symfony Mailer DSN: host, port and
# credentials in one value, and nowhere else. Empty (the default) means no
# mail is sent at all: the channel logs what it would have sent, and the
# delivery record says so. The user part must be URL-encoded (@ is %40).
#   smtp://no-reply%40your-domain.example:PASSWORD@mail.your-domain.example:465
#   smtp://user:pass@host:587   (STARTTLS)
MAIL_DSN=
# The From address on every mail, optionally with a name.
MAIL_FROM="Your platform <no-reply@your-domain.example>"

# --- Telling a product what happened (ADR-051 §5) ----------------------------
# The secret that signs webhooks to a product beside the platform is issued
# from the console and kept sealed under this key — so a copy of the database
# is not a copy of every product's secret. At least 32 characters, private to
# this deployment; change it and every issued secret has to be reissued.
# Empty, no webhook secret can be issued and no event is delivered.
#
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
WEBHOOK_SECRET_KEY=

# --- Database ----------------------------------------------------------------
# PostgreSQL (ADR-009). Wired in M2, unused today.
DATABASE_DSN=
DATABASE_USER=
DATABASE_PASSWORD=

# --- Payments (ADR-022) ------------------------------------------------------
# Payment provider signing secret. Without it no provider is configured and
# the platform cannot take money — deliberately, so a deployment never accepts
# webhooks whose signatures anybody could forge.
#
# The stub is not a real PSP: it exists so the whole payment path can be
# exercised end to end, and so the first real adapter has a worked example.
STUB_PAYMENT_SIGNING_SECRET=

# Stripe (ADR-048). All three or none: a secret key with no webhook secret
# would start payments and never learn what became of them. Sandbox and test
# mode issue sk_test_/pk_test_ and move no money; only production issues
# sk_live_. The webhook secret is the endpoint's (whsec_…) — from the Stripe
# dashboard, or printed by `stripe listen --forward-to
# 127.0.0.1:8080/api/v1/webhooks/payments/stripe` for local development.
# When both Stripe and the stub are configured, Stripe is the default.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- E-invoicing (ADR-023) ---------------------------------------------------
# Signing secret for the approved platform's webhooks. Empty means no platform
# is configured and nothing can be transmitted — deliberately, because a
# transmission record produced by an adapter whose signatures nobody can verify
# would be worse than none: it could be mistaken for evidence of compliance.
STUB_EINVOICE_SIGNING_SECRET=
