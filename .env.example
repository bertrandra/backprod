# Copy to .env and fill in. Never commit .env (Architecture V2 §31: secrets hors Git).

APP_ENV=dev
APP_DEBUG=true

# --- Identity (ADR-014) ------------------------------------------------------
# The JWK set tokens are verified against, as JSON: {"keys":[{...}]}
# Left empty, the API verifies no key and authenticates nobody, which is the
# safe default for an unconfigured deployment.
SUPABASE_JWKS=
# Expected `iss` claim, e.g. https://<project>.supabase.co/auth/v1
SUPABASE_ISSUER=
# Expected `aud` claim. Supabase issues "authenticated" for signed-in users.
SUPABASE_AUDIENCE=authenticated

# --- Database ----------------------------------------------------------------
# PostgreSQL (ADR-009). Wired in M2, unused today.
DATABASE_DSN=
DATABASE_USER=
DATABASE_PASSWORD=

# --- Payments (ADR-022) ------------------------------------------------------
# Payment provider signing secret. Without it no provider is configured and
# the platform cannot take money — deliberately, so a deployment never accepts
# webhooks whose signatures anybody could forge.
#
# The stub is not a real PSP: it exists so the whole payment path can be
# exercised end to end, and so the first real adapter has a worked example.
STUB_PAYMENT_SIGNING_SECRET=
