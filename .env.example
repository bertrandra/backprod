# Copy to .env and fill in. Never commit .env (Architecture V2 §31: secrets hors Git).

APP_ENV=dev
APP_DEBUG=true

# Product context (ADR pending, decision D1 in docs/backend-roadmap.md)
PRODUCT_HEADER=X-Product

# Database — PostgreSQL (ADR-009). Wired in M2, unused at M0.
DATABASE_DSN=
DATABASE_USER=
DATABASE_PASSWORD=

# Auth provider — Supabase behind AuthProvider (decision D4). Wired in M1.
SUPABASE_PROJECT_URL=
SUPABASE_JWKS_URL=
