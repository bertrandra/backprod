# Copy to .env and fill in. Never commit .env (Architecture V2 §31: secrets hors Git).

APP_ENV=dev
APP_DEBUG=true

# --- Identity (U12; supersedes ADR-014 for issuance) --------------------------
# This platform issues its own tokens now, so it needs no identity provider and
# the browser holds no key. One secret, and everything else has a default.
#
# At least 32 characters — HS256 refuses a shorter key, and the sign-in endpoint
# then answers 503 saying so. Generate one with:
#
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
#
# Empty, nobody can sign in and nothing can be authenticated: the safe default for
# an unconfigured deployment, and `preflight` says so out loud.
AUTH_SIGNING_SECRET=
# Stamped into every token and checked on every request. The defaults are fine;
# they exist so a token minted for one deployment is refused by another that
# happens to share a secret, which is what a copied .env creates.
# AUTH_ISSUER=backprod
# AUTH_AUDIENCE=backprod-api
# How long an access token lives, in seconds. The refresh cookie lasts 30 days.
# AUTH_TOKEN_LIFETIME=3600

# --- Identity, the other way (ADR-014) ---------------------------------------
# Only if you want an external provider to issue tokens instead. Setting
# AUTH_SIGNING_SECRET wins over these, deliberately: a deployment given its own
# signing secret has been configured to be self-contained.
SUPABASE_JWKS=
SUPABASE_ISSUER=
SUPABASE_AUDIENCE=authenticated

# --- Where this deployment answers -------------------------------------------
# Used to build the links this platform puts in emails — today, the address
# confirmation a storefront sign-up sends. There is no default on purpose:
# deriving it from a request's Host header would let anybody who can reach the
# API decide where a confirmation link points. Left empty, the link is relative
# and therefore useless in a mail client, which is the honest failure.
APP_URL=https://your-domain.example

# --- Database ----------------------------------------------------------------
# PostgreSQL (ADR-009). Wired in M2, unused today.
DATABASE_DSN=
DATABASE_USER=
DATABASE_PASSWORD=

# --- Payments (ADR-022) ------------------------------------------------------
# Payment provider signing secret. Without it no provider is configured and
# the platform cannot take money — deliberately, so a deployment never accepts
# webhooks whose signatures anybody could forge.
#
# The stub is not a real PSP: it exists so the whole payment path can be
# exercised end to end, and so the first real adapter has a worked example.
STUB_PAYMENT_SIGNING_SECRET=

# --- E-invoicing (ADR-023) ---------------------------------------------------
# Signing secret for the approved platform's webhooks. Empty means no platform
# is configured and nothing can be transmitted — deliberately, because a
# transmission record produced by an adapter whose signatures nobody can verify
# would be worse than none: it could be mistaken for evidence of compliance.
STUB_EINVOICE_SIGNING_SECRET=
